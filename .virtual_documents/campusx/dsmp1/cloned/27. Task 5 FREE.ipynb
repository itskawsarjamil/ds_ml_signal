print(inpt)
output=tuple()
for i,value in enumerate(inpt):
    print(i,value)
    # if i==len(inpt):
    if i==0:
        output+=(value*inpt[i+1],)
    elif i+1==len(inpt):
        output+=(value*inpt[i-1],)
    else:
        output+=((inpt[i-1]*value)+(value*inpt[i+1]),)

print(output)





